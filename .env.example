# ---- MySQL 连接（必填，除非用 API_DATABASE_URL 覆盖）----
HK_DB_MYSQL_HOST=127.0.0.1
HK_DB_MYSQL_PORT=3306
HK_DB_MYSQL_USER=readonly_user
HK_DB_MYSQL_PWD=change_me
HK_DB_MYSQL_DB=everything

# ---- 服务行为（可选）----
API_HOST=0.0.0.0
API_PORT=8000
# 是否允许非只读语句，默认 false
API_ALLOW_WRITE=false
# 单次查询返回的最大行数
API_MAX_ROWS=5000
# 查询超时，毫秒（仅 MySQL 生效）
API_QUERY_TIMEOUT_MS=30000
# 逗号分隔的允许来源，* 表示放行所有来源
API_CORS_ORIGINS=*
# 是否允许跨域携带 Cookie / Authorization
API_CORS_ALLOW_CREDENTIALS=false

# ---- 访问统计 PV/UV（可选；API_STATS_SALT 留空则接口返回空统计）----
API_STATS_SALT=
API_STATS_PREFIX=/api/v09/stats
# 写库账号（需 INSERT/DELETE）；不填则复用 HK_DB_MYSQL_USER
API_STATS_MYSQL_USER=
API_STATS_MYSQL_PWD=

